{
  "name": "icons-v3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "validate:check": "tsx scripts/validate.ts --check",
    "generate": "tsx scripts/generate.ts",
    "build": "turbo run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run build && vitest run",
    "size": "turbo run build && size-limit",
    "check:package": "turbo run build && publint packages/core && publint packages/react && attw --pack packages/core --profile node16 && attw --pack packages/react --profile node16",
    "check:consumers": "turbo run build && pnpm --filter @bgd-labs/consumer-fixtures run check",
    "audit": "pnpm audit --prod --audit-level moderate",
    "stress": "tsx scripts/stress.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.0.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.0",
    "size-limit": "^11.1.6",
    "svgo": "^4.0.2",
    "to-words": "^4.1.0",
    "tsx": "^4.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.0"
  }
}
